{
  "name": "ma3-remote-pwa",
  "version": "1.0.0",
  "description": "Touch remote PWA for grandMA3 (encoders, shapers, cues, fixtures & colour)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build:exe": "pkg . --out-path dist"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": "server/index.js",
  "pkg": {
    "assets": ["public/**/*"],
    "targets": ["node22-win-x64", "node22-macos-arm64", "node22-macos-x64", "node22-linux-x64"]
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0"
  },
  "license": "MIT"
}
